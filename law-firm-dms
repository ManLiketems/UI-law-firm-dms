require_once __DIR__ . '/includes/bootstrap.php';
$u = require_role(['Administrator']);
$pdo = db();
const SEP = "\n-- ---- STATEMENT ----\n";

function make_dump(PDO $pdo): string
{
    $out = '-- DMS backup generated ' . date('Y-m-d H:i:s') . SEP . 'SET FOREIGN_KEY_CHECKS=0' . SEP;
    $tables = $pdo->query('SHOW TABLES')->fetchAll(PDO::FETCH_COLUMN);
    foreach ($tables as $t) {
        $out .= 'DROP TABLE IF EXISTS `' . $t . '`' . SEP;
        $row = $pdo->query('SHOW CREATE TABLE `' . $t . '`')->fetch(PDO::FETCH_NUM);
        $out .= $row[1] . SEP;
        $rows = $pdo->query('SELECT * FROM `' . $t . '`');
        while ($r = $rows->fetch(PDO::FETCH_NUM)) {
            $vals = array_map(function ($v) use ($pdo) { return $v === null ? 'NULL' : $pdo->quote((string)$v); }, $r);
            $out .= 'INSERT INTO `' . $t . '` VALUES (' . implode(',', $vals) . ')' . SEP;
        }
    }
    return $out . 'SET FOREIGN_KEY_CHECKS=1' . SEP;
}

if (isset($_GET['download'])) {
    $what = $_GET['download'];
    if ($what === 'db') {
        audit('database backup downloaded');
        $sql = make_dump($pdo);
        header('Content-Type: application/sql');
        header('Content-Disposition: attachment; filename="dms_backup_' . date('Ymd_His') . '.sql"');
        header('Content-Length: ' . strlen($sql));
        echo $sql;
        exit;
    }
    if ($what === 'files') {
        if (!class_exists('ZipArchive')) {
            flash('error', 'The PHP zip extension is not enabled, so a zip of the documents cannot be created.');
            redirect('backup.php');
        }
        $tmp = tempnam(sys_get_temp_dir(), 'dms');
        $zip = new ZipArchive();
        if ($zip->open($tmp, ZipArchive::OVERWRITE) !== true) { flash('error', 'Could not create the zip file.'); redirect('backup.php'); }
        $dir = storage_dir();
        foreach (scandir($dir) as $f) {
            if ($f !== '.' && $f !== '..' && $f !== '.htaccess' && is_file($dir . DIRECTORY_SEPARATOR . $f)) $zip->addFile($dir . DIRECTORY_SEPARATOR . $f, $f);
        }
        $zip->close();
        audit('document store backup downloaded');
        header('Content-Type: application/zip');
        header('Content-Disposition: attachment; filename="dms_documents_' . date('Ymd_His') . '.zip"');
        header('Content-Length: ' . filesize($tmp));
        readfile($tmp);
        @unlink($tmp);
        exit;
    }
}

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    csrf_check();
    $f = $_FILES['backup'] ?? null;
    if (trim($_POST['confirm'] ?? '') !== 'RESTORE') {
        flash('error', 'Type RESTORE in capital letters to confirm.');
    } elseif (!$f || $f['error'] !== UPLOAD_ERR_OK) {
        flash('error', 'Choose the .sql backup file to restore.');
    } else {
        $sql = (string)file_get_contents($f['tmp_name']);
        if (strpos(substr($sql, 0, 60), '-- DMS backup generated') !== 0) {
            flash('error', 'This is not a backup file created by this system.');
        } else {
            try {
                foreach (explode(SEP, $sql) as $stmt) {
                    $stmt = trim($stmt);
                    if ($stmt === '' || strpos($stmt, '--') === 0) continue;
                    $pdo->exec($stmt);
                }
                audit('database restored from backup');
                flash('success', 'The database was restored from the backup file.');
            } catch (Throwable $e) {
                flash('error', 'Restore failed: ' . $e->getMessage());
            }
        }
    }
    redirect('backup.php');
}

