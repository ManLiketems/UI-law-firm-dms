$cases = accessible_cases($u);
$cats = $pdo->query('SELECT category_id, category_name FROM categories ORDER BY category_name')->fetchAll();

// "Upload new version" mode: upload.php?doc=ID pre-fills the case and title
$prefill = ['case_id' => (int)($_GET['case'] ?? 0), 'title' => '', 'category_id' => 0, 'locked' => false];
if (isset($_GET['doc'])) {
    $d = get_document((int)$_GET['doc']);
    if ($d && can_access_document($u, $d)) {
        $prefill = ['case_id' => (int)$d['case_id'], 'title' => $d['title'], 'category_id' => (int)$d['category_id'], 'locked' => true];
    }
}

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    csrf_check();
    $case_id = (int)($_POST['case_id'] ?? 0);
    $title = trim($_POST['title'] ?? '');
    $cat_id = (int)($_POST['category_id'] ?? 0);
    $conf = $_POST['confidentiality_level'] ?? 'Normal';
    $visible = isset($_POST['client_visible']) ? 1 : 0;
    $desc = trim($_POST['description'] ?? '');
    $errors = [];

    if (!can_access_case($u, $case_id)) $errors[] = 'Choose a case you are allowed to upload to.';
    if ($title === '' || mb_strlen($title) > 200) $errors[] = 'Enter the document title (up to 200 characters).';
    $chk = $pdo->prepare('SELECT 1 FROM categories WHERE category_id = ?');
    $chk->execute([$cat_id]);
    if (!$chk->fetchColumn()) $errors[] = 'Choose the document type.';
    if (!in_array($conf, ['Normal', 'Confidential', 'Restricted'], true)) $conf = 'Normal';
    if (mb_strlen($desc) > 2000) $errors[] = 'Keywords/description is too long.';

    $f = $_FILES['file'] ?? null;
    $ext = '';
    if (!$f || $f['error'] === UPLOAD_ERR_NO_FILE) {
        $errors[] = 'Choose a file to upload.';
    } elseif ($f['error'] === UPLOAD_ERR_INI_SIZE || $f['error'] === UPLOAD_ERR_FORM_SIZE) {
        $errors[] = 'The file is larger than the size allowed by the server (check upload_max_filesize in php.ini).';
    } elseif ($f['error'] !== UPLOAD_ERR_OK) {
        $errors[] = 'The file could not be uploaded (error code ' . (int)$f['error'] . ').';
    } else {
        $ext = strtolower(pathinfo($f['name'], PATHINFO_EXTENSION));
        if (!in_array($ext, ALLOWED_EXT, true)) $errors[] = 'File type not allowed. Allowed: ' . implode(', ', ALLOWED_EXT) . '.';
        if ($f['size'] <= 0) $errors[] = 'The file is empty.';
        if ($f['size'] > MAX_FILE_SIZE) $errors[] = 'The file is larger than 25 MB.';
    }

    // does a document with this title already exist in the case? then this upload is a new version
    $existing = null;
    if (!$errors) {
        $st = $pdo->prepare('SELECT document_id FROM documents WHERE case_id = ? AND LOWER(title) = LOWER(?) LIMIT 1');
        $st->execute([$case_id, $title]);
        $eid = $st->fetchColumn();
        if ($eid) {
            $existing = get_document((int)$eid);
            if (!$existing || !can_access_document($u, $existing)) {
                $errors[] = 'A document with this title already exists in the case and you do not have permission to add a version to it.';
            }
        }
    }

    if (!$errors) {
        $hash = hash_file('sha256', $f['tmp_name']);
        $stored = bin2hex(random_bytes(16)) . '.' . $ext;
        $dest = storage_dir() . DIRECTORY_SEPARATOR . $stored;
        if (!move_uploaded_file($f['tmp_name'], $dest)) {
            $errors[] = 'The file could not be saved to the document store.';
        } else {
            try {
                $pdo->beginTransaction();
                if ($existing) {
                    $doc_id = (int)$existing['document_id'];
                    $vno = (int)$existing['current_version'] + 1;
                    $pdo->prepare('UPDATE documents SET current_version = ? WHERE document_id = ?')->execute([$vno, $doc_id]);
                } else {
                    $pdo->prepare('INSERT INTO documents (case_id, category_id, title, description, confidentiality_level, client_visible, current_version, upload_date)
                                   VALUES (?, ?, ?, ?, ?, ?, 1, NOW())')
                        ->execute([$case_id, $cat_id, $title, $desc !== '' ? $desc : null, $conf, $visible]);
                    $doc_id = (int)$pdo->lastInsertId();
                    $vno = 1;
                }
                $orig = mb_substr(basename((string)$f['name']), 0, 255);
                $pdo->prepare('INSERT INTO document_versions (document_id, uploaded_by, version_no, file_name, file_path, file_size, file_hash, uploaded_at)
                               VALUES (?, ?, ?, ?, ?, ?, ?, NOW())')
                    ->execute([$doc_id, (int)$u['user_id'], $vno, $orig, $stored, (int)$f['size'], $hash]);
                $pdo->commit();
