$error = '';
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    csrf_check();
    $login = trim($_POST['login'] ?? '');
    $pass  = (string)($_POST['password'] ?? '');
    if ($login === '' || $pass === '') {
        $error = 'Enter your username or email and your password.';
    } else {
        $st = db()->prepare('SELECT u.*, r.role_name FROM users u JOIN roles r ON r.role_id = u.role_id
                             WHERE u.username = ? OR u.email = ? LIMIT 1');
        $st->execute([$login, $login]);
        $u = $st->fetch();
        if (!$u) {
            audit('failed login: unknown user');
            $error = 'Invalid username/email or password.';
        } elseif ($u['status'] === 'Locked') {
            audit('login blocked: account locked', null, (int)$u['user_id']);
            $error = 'This account is locked after repeated failed logins. Contact the Administrator.';
        } elseif ($u['status'] === 'Disabled') {
            audit('login blocked: account disabled', null, (int)$u['user_id']);
            $error = 'This account has been disabled. Contact the Administrator.';
        } elseif (password_verify($pass, $u['password_hash'])) {
            session_regenerate_id(true);
            $_SESSION['user'] = [
                'user_id'   => (int)$u['user_id'],
                'username'  => $u['username'],
                'full_name' => $u['full_name'],
                'role_name' => $u['role_name'],
                'client_id' => $u['client_id'] !== null ? (int)$u['client_id'] : null,
            ];
            $_SESSION['last_activity'] = time();
            db()->prepare('UPDATE users SET failed_attempts = 0, last_login = NOW() WHERE user_id = ?')->execute([(int)$u['user_id']]);
            audit('login', null, (int)$u['user_id']);
            redirect('dashboard.php');
        } else {
            $n = (int)$u['failed_attempts'] + 1;
            if ($n >= MAX_FAILED) {
                db()->prepare("UPDATE users SET failed_attempts = ?, status = 'Locked' WHERE user_id = ?")->execute([$n, (int)$u['user_id']]);
                audit('failed login', null, (int)$u['user_id']);
                audit('account locked after failed logins', null, (int)$u['user_id']);
                $error = 'Too many failed attempts. The account has been locked and the Administrator will see it on the dashboard.';
            } else {
                db()->prepare('UPDATE users SET failed_attempts = ? WHERE user_id = ?')->execute([$n, (int)$u['user_id']]);
                audit('failed login', null, (int)$u['user_id']);
                $error = 'Invalid username/email or password. ' . (MAX_FAILED - $n) . ' attempt(s) left before the account is locked.';
            }
        }
    }
}
