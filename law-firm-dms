        $court = trim($_POST['court'] ?? '');
        $status = $_POST['status'] ?? 'Open';
        $opened = $_POST['date_opened'] ?? '';
        $err = '';
        $chk = $pdo->prepare('SELECT 1 FROM clients WHERE client_id = ?');
        $chk->execute([$client_id]);
        if (!$chk->fetchColumn()) $err = 'Choose a registered client.';
        elseif ($number === '' || mb_strlen($number) > 30) $err = 'Enter a case number (up to 30 characters).';
        elseif ($title === '' || mb_strlen($title) > 200) $err = 'Enter the case title (up to 200 characters).';
        elseif (!in_array($type, $types, true)) $err = 'Choose the case type.';
        elseif (!in_array($status, ['Open', 'Pending', 'Closed'], true)) $err = 'Choose a valid status.';
        elseif (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $opened)) $err = 'Enter the date the case was opened.';
        if ($err) {
            flash('error', $err);
        } else {
            try {
                $pdo->beginTransaction();
                $st = $pdo->prepare('INSERT INTO cases (client_id, case_number, title, case_type, court, status, date_opened, date_closed) VALUES (?, ?, ?, ?, ?, ?, ?, ?)');
                $st->execute([$client_id, $number, $title, $type, $court !== '' ? $court : null, $status, $opened, $status === 'Closed' ? date('Y-m-d') : null]);
                $case_id = (int)$pdo->lastInsertId();
                if ($isLawyer) {
                    $pdo->prepare('INSERT INTO case_assignments (case_id, user_id, assigned_role, date_assigned) VALUES (?, ?, ?, CURDATE())')
                        ->execute([$case_id, (int)$u['user_id'], 'Lead Counsel']);
                }
                $pdo->commit();
                audit('case created: ' . $number);
                flash('success', 'Case file ' . $number . ' was created.');
            } catch (PDOException $e) {
                if ($pdo->inTransaction()) $pdo->rollBack();
                flash('error', 'That case number already exists.');
            }
        }
    } elseif ($action === 'assign_me' && $isLawyer) {
        $case_id = (int)($_POST['case_id'] ?? 0);
        $chk = $pdo->prepare('SELECT case_number FROM cases WHERE case_id = ?');
        $chk->execute([$case_id]);
        $num = $chk->fetchColumn();
        if ($num) {
            $pdo->prepare('INSERT IGNORE INTO case_assignments (case_id, user_id, assigned_role, date_assigned) VALUES (?, ?, ?, CURDATE())')
                ->execute([$case_id, (int)$u['user_id'], 'Lead Counsel']);
            audit('case assigned to lawyer: ' . $num);
            flash('success', 'You have been assigned to case ' . $num . '.');
