                if ($pdo->inTransaction()) $pdo->rollBack();
                @unlink($dest);
                $errors[] = 'The document could not be saved. Please try again.';
            }
        }
    }
    foreach ($errors as $e) flash('error', $e);
    $prefill = ['case_id' => $case_id, 'title' => $title, 'category_id' => $cat_id, 'locked' => false];
